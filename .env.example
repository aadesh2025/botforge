# BotForge environment. Copy to .env and fill in. See docs/ENV.md for the full reference.
# Lines marked [HUMAN] can only be created by you; leave blank to run with that feature stubbed.
#
# FORMATTING RULE — a comment never shares a line with a blank value.
# `KEY=            # note` does NOT parse to an empty string: the spaces after `=` are consumed
# as the separator, so the `#` starts the value and the comment text becomes the value. That
# shipped a placeholder to Google as a real API key once (ADR-044). `KEY=value  # note` is fine,
# but keep new placeholders in the documented shape below and the trap can't come back.

# ── Core ─────────────────────────────────────────────────────────────────────
ENV=dev                                   # dev | test | prod
LOG_LEVEL=info
# [HUMAN] JWT signing + key encryption
SECRET_KEY=change-me-generate-a-long-random-string
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Production deploy (docker-compose.prod.yml + Caddy TLS) ───────────────────
# [HUMAN] dashboard hostname (Caddy auto-TLS)
DOMAIN=app.example.com
# [HUMAN] API hostname (Caddy auto-TLS)
API_DOMAIN=api.example.com
# [HUMAN] Let's Encrypt contact email
ACME_EMAIL=you@example.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000   # prod: https://$API_DOMAIN (baked into the web build)
BACKUP_RETENTION_DAYS=14                   # nightly pg_dump retention (prod backup service)

# ── Datastores (compose sets these to in-network hosts automatically) ────────
POSTGRES_USER=botforge
POSTGRES_PASSWORD=botforge
POSTGRES_DB=botforge
DATABASE_URL=postgresql+asyncpg://botforge:botforge@localhost:5432/botforge
REDIS_URL=redis://localhost:6379/0

# ── LLM providers (free-first). Unset → provider stubbed + warned. ───────────
# [HUMAN] default provider (free signup)
GROQ_API_KEY=
# [HUMAN] Google Gemini free tier
GEMINI_API_KEY=
# [HUMAN] free models via OpenRouter
OPENROUTER_API_KEY=
# [HUMAN] paid
OPENAI_API_KEY=
# [HUMAN] paid
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434    # local models + embeddings (bundled)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# ── OAuth (unset → login button hidden/denied) ───────────────────────────────
# [HUMAN]
GOOGLE_CLIENT_ID=
# [HUMAN]
GOOGLE_CLIENT_SECRET=
# [HUMAN]
GITHUB_CLIENT_ID=
# [HUMAN]
GITHUB_CLIENT_SECRET=

# ── Channels (unset → channel disabled with a clear message) ─────────────────
# [HUMAN]
TELEGRAM_BOT_TOKEN=
# [HUMAN] shared by WhatsApp + Messenger + Instagram
META_APP_SECRET=
# [HUMAN]
WHATSAPP_PHONE_ID=
# [HUMAN]
WHATSAPP_TOKEN=
# [HUMAN]
WHATSAPP_VERIFY_TOKEN=
# [HUMAN] Facebook Messenger page token
META_PAGE_ACCESS_TOKEN=
# [HUMAN] the Page that receives Messenger DMs
META_PAGE_ID=
# [HUMAN] Instagram-scoped page token (instagram_manage_messages)
INSTAGRAM_PAGE_ACCESS_TOKEN=
# [HUMAN] the Instagram professional account id
INSTAGRAM_USER_ID=
# you choose; echoed back during Meta's webhook handshake
META_VERIFY_TOKEN=
# [HUMAN]
SLACK_BOT_TOKEN=
# [HUMAN]
SLACK_SIGNING_SECRET=
# [HUMAN]
DISCORD_BOT_TOKEN=
# [HUMAN]
DISCORD_PUBLIC_KEY=

# ── n8n ──────────────────────────────────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678        # must match the bundled n8n's host port
# The bundled n8n's host port is `N8N_HOST_PORT` (default 5678) — but note that Compose reads
# *interpolation* variables from the shell or from `infra/.env`, NOT from this file (this file
# is passed to containers via `env_file`). So to move it:
#     cd infra && N8N_HOST_PORT=5679 docker compose up -d n8n   # or put it in infra/.env
# then set N8N_BASE_URL=http://localhost:5679 here.
# [HUMAN] n8n → Settings → API; needs the workflow
#   read/list/create/update/activate scopes
N8N_API_KEY=
# generate a random string
N8N_WEBHOOK_SIGNING_SECRET=
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=botforge

# ── Client provisioning (scripts/provision-client.mjs) ───────────────────────
# One command stands a client up: org + published agent + n8n automation + invite.
# Identical on a laptop and on a VPS — only these URLs differ.
BOTFORGE_API_BASE_URL=http://localhost:8000
# [HUMAN] a staff login (is_staff=true). Creating an org is gated on that flag
#   server-side, so an API key cannot provision — there is no such scope.
PROVISION_STAFF_EMAIL=
# [HUMAN] that account's password
PROVISION_STAFF_PASSWORD=

# ── Email (console backend needs no setup in dev) ────────────────────────────
# console = logged to an in-memory outbox, nothing leaves the machine.
# smtp    = real delivery. Any SMTP relay works — Resend and Postmark both have a free
#           tier that suits a first handful of clients. You must also verify your sending
#           domain (SPF/DKIM records) in the provider's dashboard, or Gmail will spam-bin it.
EMAIL_BACKEND=console                     # console | smtp — set smtp once SMTP_* below are filled in
# [HUMAN] e.g. smtp.resend.com — any SMTP relay works
SMTP_HOST=
SMTP_PORT=587
# [HUMAN] from your email provider
SMTP_USER=
# [HUMAN] from your email provider
SMTP_PASS=
# [HUMAN] e.g. "BotForge <noreply@yourdomain.com>"
SMTP_FROM=

# ── Billing (optional; unset → billing disabled) ─────────────────────────────
# [HUMAN]
STRIPE_SECRET_KEY=
# [HUMAN]
STRIPE_WEBHOOK_SECRET=

# ── Observability ────────────────────────────────────────────────────────────
# optional
SENTRY_DSN=

# ── Storage & RAG ────────────────────────────────────────────────────────────
STORAGE_BACKEND=local                     # local | s3
UPLOAD_DIR=./var/uploads                  # where ingested document files are stored (local backend)
RAG_CONTEXT_CHAR_BUDGET=8000              # max chars of retrieved context injected into a prompt
CELERY_TASK_ALWAYS_EAGER=false            # true = run ingestion inline (no worker); dev/testing only
LLM_FORCE_FAKE=false                       # true = force every chat/embedding onto the Fake provider (E2E/CI only; NEVER prod)
WEBHOOK_SWEEP_INTERVAL_SECONDS=60          # how often Celery beat re-enqueues due pending webhook deliveries

# ── Chat runtime, memory & tools ─────────────────────────────────────────────
MEMORY_WINDOW_MESSAGES=12                 # recent turns kept verbatim in the prompt
MEMORY_SUMMARY_THRESHOLD=24               # summarize older turns once a convo exceeds this many msgs
SUMMARY_PROVIDER=groq                     # provider for background summaries (small/fast, NOT the agent's)
SUMMARY_MODEL=llama-3.1-8b-instant        # summary model; falls back to the fake provider if unkeyed
TOOL_MAX_ITERATIONS=4                     # max tool-call iterations per turn (Phase 9)
TOOL_TIMEOUT_SECONDS=15                   # per-tool execution timeout (Phase 9)

# ── Guardrails (docs/11) ─────────────────────────────────────────────────────
# Hard ceiling on one visitor message; also the LLM10 unbounded-consumption control.
MAX_USER_MESSAGE_CHARS=8000
# L1 static pre-filter on the visitor's own message (direct prompt injection, OWASP LLM01).
# Off means retrieved content is defended but the person typing is not.
GUARD_INPUT_ENABLED=true
# L5 output guardrail: system-prompt leakage and persona breaks.
GUARD_OUTPUT_ENABLED=true
# Fraction of a reply's 8-grams that may also appear in the system prompt before it is
# treated as leakage and replaced.
GUARD_OUTPUT_LEAK_THRESHOLD=0.35

# ── Test-only switches (NEVER set these in production) ───────────────────────
# Lets a non-staff user create an organization. Production is staff-only: BotForge is
# provisioned per client, and with this on anyone who can reach /signup can hand themselves
# a workspace. The test suites need it because they bootstrap a tenant per test via the API.
ALLOW_SELF_SERVE_ORGS=false
